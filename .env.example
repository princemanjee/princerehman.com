# princerehman.com — environment template.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is not, so it stays in version control as the canonical
# list of required vars.

# Public URL of the Cloudflare Worker that brokers Anthropic API calls
# for the Adaptive CV's JD-paste flow. Exposed to the client bundle
# because Astro's `PUBLIC_*` prefix makes a var available via
# `import.meta.env.PUBLIC_CV_GATEWAY_URL` in browser code.
#
# Provisioned by deploying the Worker in `gateway/` — see
# `gateway/README.md` for the deploy flow. The URL looks like:
#   https://princerehman-cv-gateway.<your-account>.workers.dev
PUBLIC_CV_GATEWAY_URL=

# Formspree form ID for the /contact form. This is the 8-character code at
# the end of the endpoint URL, NOT the full URL: for
# https://formspree.io/f/xyzabcde the value here is just `xyzabcde`.
#
# Get one by creating a free form at https://formspree.io. Set the same
# value as an Actions repository variable named PUBLIC_FORMSPREE_ID so
# production builds resolve it (.github/workflows/deploy.yml forwards it).
#
# Left blank, /contact renders its fields but cannot submit, and shows a
# direct-email fallback instead. That is intentional: a form posting to a
# placeholder endpoint would 404 and lose a real inquiry.
PUBLIC_FORMSPREE_ID=
