---
/**
 * Container: max-width content wrapper with horizontal padding.
 *
 * Phase 1 layout primitive. Use it to constrain content to a readable
 * width and provide consistent gutters across pages.
 *
 * Sizes read from the --content-width-* tokens in tokens.css, which are the
 * single source of truth for how wide content runs anywhere on the site:
 *   sm  — 768px   short-form copy, modals
 *   md  — 960px   long-form prose
 *   lg  — 1232px  general page content (default)
 *   xl  — 1440px  wider grids, case studies
 *   2xl — 1728px  full-bleed dashboards
 *
 * These are layout widths, not reading measures. Prose inside a Container is
 * still held to a ch-based max-width by the consuming page, because a line of
 * text running much past ~75 characters is harder to read regardless of how
 * much screen is available.
 *
 * Pass an HTML element via `as` to render as something other than div
 * (section, article, etc.). All other props are passed through.
 */

interface Props {
  size?: "sm" | "md" | "lg" | "xl" | "2xl";
  as?: "div" | "section" | "article" | "main" | "header" | "footer";
  class?: string;
}

const { size = "lg", as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag class:list={["container", `container--${size}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .container--sm  { max-width: var(--content-width-sm); }
  .container--md  { max-width: var(--content-width-md); }
  .container--lg  { max-width: var(--content-width-lg); }
  .container--xl  { max-width: var(--content-width-xl); }
  .container--2xl { max-width: var(--content-width-2xl); }

  @media (max-width: 600px) {
    .container {
      padding-inline: var(--space-md);
    }
  }
</style>
