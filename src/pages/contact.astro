---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import GlassPanel from "../components/GlassPanel.astro";
import GlassButton from "../components/GlassButton.astro";
import GlassField from "../components/GlassField.astro";
import GlassInput from "../components/GlassInput.astro";
import GlassTextarea from "../components/GlassTextarea.astro";
import GlassSelect from "../components/GlassSelect.astro";

/*
 * Contact page.
 *
 * Backend: Formspree, form ID `xeeydpkn`.
 *
 * The ID is baked in as the default rather than being CI-only config. A
 * Formspree form ID is not a secret: it ships in the page source of every
 * form that uses it, so hiding it buys nothing. Making it the default
 * instead removes a real failure mode, which is a deploy that silently
 * renders the direct-email fallback because an Actions variable was never
 * added. PUBLIC_FORMSPREE_ID still overrides it when set, which is useful
 * for pointing a branch or a local build at a throwaway test form.
 *
 * Submission is progressively enhanced:
 *   - No JS: the native form POSTs to Formspree and the visitor lands on
 *     Formspree's own thank-you page. Fully functional, just off-site.
 *   - With JS: @formspree/ajax intercepts the submit, posts in the
 *     background, and swaps in an inline success message, so the visitor
 *     never leaves the site. Field-level validation errors render next to
 *     the offending input and the submit button self-disables in flight.
 *
 * The `action` and `method` attributes therefore stay on the form even
 * though the AJAX path usually handles it. They are the no-JS fallback,
 * and the library reads the endpoint from its own formId config.
 *
 * To switch the form off deliberately, set PUBLIC_FORMSPREE_ID to one of the
 * DISABLE_VALUES sentinels below ("none", "off", "false", "disabled"). A
 * blank value does NOT disable it and falls back to the default instead;
 * see the comment on envFormspreeId for why that distinction matters.
 *
 * In the disabled state the page renders its fields inside an inert div
 * rather than a form, so nothing can post to a dead endpoint and lose a
 * real inquiry, and a notice routes the visitor to direct email. Contact is
 * never a dead end.
 *
 * Alternative backends, if Formspree is ever swapped out: Web3Forms,
 * FormSubmit, or a small Cloudflare Worker (this repo already deploys one
 * in gateway/ for the CV). Any of them only needs the endpoint below and
 * the hidden field names adjusted to that service's convention.
 */

const DEFAULT_FORMSPREE_ID = "xeeydpkn";

/*
 * Sentinels that deliberately disable the form. Needed because "empty means
 * disabled" is not usable here (see below), so switching the form off has to
 * be something explicit rather than the absence of a value.
 */
const DISABLE_VALUES = new Set(["none", "off", "false", "disabled"]);

/*
 * An empty override must fall back to the default, NOT disable the form.
 *
 * deploy.yml passes `${{ vars.PUBLIC_FORMSPREE_ID }}`, and GitHub substitutes
 * an empty string when that repository variable does not exist. Empty string
 * is not nullish, so `?? DEFAULT` does not catch it: the first deploy of this
 * page went live showing the direct-email fallback instead of the form, which
 * is exactly the silent degradation the baked-in default was meant to prevent.
 * Treat blank and whitespace as "no override supplied".
 */
const envFormspreeId = String(
  import.meta.env.PUBLIC_FORMSPREE_ID ?? "",
).trim();
const formspreeId =
  envFormspreeId.length > 0 ? envFormspreeId : DEFAULT_FORMSPREE_ID;

/*
 * Guard the historical placeholder so an accidental copy of the old value
 * cannot resurrect a form that posts nowhere, and honour the explicit
 * disable sentinels.
 */
const isFormLive =
  formspreeId.length > 0 &&
  formspreeId !== "YOUR_FORMSPREE_ID" &&
  !DISABLE_VALUES.has(formspreeId.toLowerCase());

const formAction = isFormLive
  ? `https://formspree.io/f/${formspreeId}`
  : undefined;

/*
 * Dynamic wrapper tag: a real <form> only when there is a live endpoint to
 * post to, otherwise an inert <div> that cannot submit even on Enter.
 */
const FormWrapper = isFormLive ? "form" : "div";

const subjectOptions = [
  { value: "consulting", label: "Consulting engagement" },
  { value: "leadership", label: "IT leadership role" },
  { value: "fieldforce", label: "FieldForce Tool Tracker licensing" },
  { value: "speaking", label: "Speaking or advisory" },
  { value: "other", label: "Something else" },
];
---

<BaseLayout
  title="Contact — P. R. Manjee"
  description="Get in touch about consulting engagements, IT leadership roles, FieldForce licensing inquiries, or related work. P. R. Manjee, Senior Technology Consultant based in Chicago.">
  <article class="contact">
    <PageHeader
      pageTitle="Contact"
      meta="For consulting engagements, leadership roles, FieldForce licensing, or anything else."
    />

    <p class="contact-lede">
      The fastest way to reach me is by sending a brief message about what you
      are working on and what kind of help you are looking for. I respond
      personally to every message within two business days. Currently taking on
      a small number of engagements per quarter to ensure each one gets the
      attention it deserves.
    </p>

    <div class="contact-grid">
      {/* Left column: the form. */}
      <GlassPanel size="xl" class="contact-form-panel" padded={false}>
        {/*
          Status regions for the AJAX path.

          Both sit outside the form wrapper on purpose: the library resolves
          them by looking inside the form first and then at the form's parent,
          and keeping them outside means the success message survives the form
          being hidden on submit.

          The success copy is pre-filled rather than left to the library. Its
          setter only writes when the element is empty, so pre-filling wins and
          the visitor gets this message instead of the default "Thank you!".
          The error region stays empty because its text is the actual server
          or validation message.

          Visibility is driven by data-fs-active, which the library toggles on
          these elements. That is why it is used instead of :empty, which
          cannot hide a pre-filled success banner.
        */}
        {isFormLive && (
          <>
            <div
              class="contact-form-status contact-form-status--success"
              role="status"
              aria-live="polite"
              data-fs-success>
              Message received. I will respond personally within two business
              days.
            </div>
            <div
              class="contact-form-status contact-form-status--error"
              role="alert"
              data-fs-error
            />
          </>
        )}

        <FormWrapper
          class="contact-form"
          {...isFormLive
            ? {
                id: "contact-form",
                action: formAction,
                method: "POST",
                /*
                 * The bundled enhancement script below cannot read Astro
                 * frontmatter directly (define:vars would force the script
                 * inline and break the ESM import), so the form ID travels
                 * to the client on this attribute instead.
                 */
                "data-formspree-id": formspreeId,
              }
            : {}}>
          {/*
            Hidden field for Formspree: sets the email subject line so
            messages arrive with a recognizable header instead of the
            default "New submission from princerehman.com". Only meaningful
            when there is a live endpoint, so it is omitted otherwise.
          */}
          {isFormLive && (
            <input
              type="hidden"
              name="_subject"
              value="New inquiry from princerehman.com"
            />
          )}

          {/* Two-column row for name and email (stacks on mobile) */}
          <div class="contact-form-row">
            <GlassField label="Name" htmlFor="name" required>
              <GlassInput
                type="text"
                name="name"
                id="name"
                required
                autocomplete="name"
                placeholder="Your full name"
                data-fs-field
              />
              <span class="contact-field-error" data-fs-error="name" />
            </GlassField>

            <GlassField label="Email" htmlFor="email" required>
              <GlassInput
                type="email"
                name="email"
                id="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@example.com"
                data-fs-field
              />
              <span class="contact-field-error" data-fs-error="email" />
            </GlassField>
          </div>

          <GlassField
            label="Company or Organization"
            htmlFor="company"
            helperText="Optional. Helps me understand the context.">
            <GlassInput
              type="text"
              name="company"
              id="company"
              autocomplete="organization"
              placeholder="Your organization"
              data-fs-field
            />
            <span class="contact-field-error" data-fs-error="company" />
          </GlassField>

          <GlassField label="Topic" htmlFor="subject" required>
            <GlassSelect
              name="subject"
              id="subject"
              placeholder="Choose a topic..."
              options={subjectOptions}
              required
              data-fs-field
            />
            <span class="contact-field-error" data-fs-error="subject" />
          </GlassField>

          <GlassField
            label="Message"
            htmlFor="message"
            required
            helperText="A brief description of what you are working on and where you think I might help.">
            <GlassTextarea
              name="message"
              id="message"
              rows={6}
              required
              placeholder="Tell me about your project, role, or inquiry..."
              maxlength={4000}
              data-fs-field
            />
            <span class="contact-field-error" data-fs-error="message" />
          </GlassField>

          {isFormLive ? (
            <div class="contact-form-actions">
              <GlassButton
                type="submit"
                variant="primary"
                size="md"
                data-fs-submit-btn>
                Send message
              </GlassButton>
              <p class="contact-form-note">
                I will respond personally within two business days.
              </p>
            </div>
          ) : (
            <div class="contact-form-actions contact-form-actions--pending">
              <p class="contact-form-pending">
                This form is not accepting submissions yet. Email me directly
                and I will respond personally within two business days.
              </p>
              <GlassButton
                variant="primary"
                size="md"
                href="mailto:princemanjee@gmail.com?subject=Inquiry%20from%20princerehman.com">
                Email me directly
              </GlassButton>
            </div>
          )}
        </FormWrapper>
      </GlassPanel>

      {/* Right column: alternative contact paths */}
      <aside class="contact-alternatives">
        <GlassPanel size="md" class="contact-alt-panel" padded={false}>
          <h2 class="contact-alt-heading">Other ways to reach me</h2>

          <div class="contact-alt-section">
            <h3 class="contact-alt-label">Direct email</h3>
            <a
              href="mailto:princemanjee@gmail.com"
              class="contact-alt-link contact-alt-link--email">
              princemanjee@gmail.com
            </a>
            <p class="contact-alt-meta">
              If you prefer email over the form, send a brief message describing
              what you are looking for and I will respond.
            </p>
          </div>

          <div class="contact-alt-section">
            <h3 class="contact-alt-label">Professional networks</h3>
            <a
              href="https://www.linkedin.com/in/princemanjee/"
              rel="noopener"
              class="contact-alt-link">
              LinkedIn
            </a>
            <a
              href="https://github.com/princemanjee"
              rel="noopener"
              class="contact-alt-link">
              GitHub
            </a>
            <a
              href="https://cv.princerehman.com"
              rel="noopener"
              class="contact-alt-link">
              CV
            </a>
          </div>

          <div class="contact-alt-section">
            <h3 class="contact-alt-label">Location</h3>
            <p class="contact-alt-text">
              Based in Chicago, Illinois. Remote-first with travel as
              engagements require. Coverage across North America.
            </p>
          </div>
        </GlassPanel>
      </aside>
    </div>
  </article>
</BaseLayout>

{/*
  Progressive enhancement for the contact form.

  This is a bundled module script, not inline, so the @formspree/ajax import
  is processed by Vite and shipped as a hashed asset instead of pulling from
  a third-party CDN at runtime. That keeps the page free of external network
  dependencies, matching the rest of the site.

  The script is emitted unconditionally because Astro hoists script tags at
  build time regardless of surrounding conditionals. It no-ops safely when
  #contact-form is absent, which is exactly the unconfigured-endpoint state.

  Note: do not write a literal script tag in angle brackets anywhere in this
  comment. Vite's dev-mode dependency scanner matches that pattern with a
  naive regex and will try to parse the following prose as JavaScript, which
  breaks `astro dev` while leaving `astro build` working.
*/}
<script>
  import { initForm } from "@formspree/ajax";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const formId = form?.dataset.formspreeId;

  if (form && formId) {
    initForm({
      formElement: form,
      formId,
      /*
       * Opt out of Formspree's injected stylesheet. It would layer its own
       * error colours, success banner and loading spinner over the glass
       * language; the equivalents are styled from tokens in this page.
       */
      useDefaultStyles: false,
      onSuccess: () => {
        /*
         * Collapse the fields so the confirmation banner is what remains.
         * The banner sits outside the form element, so hiding the form does
         * not hide the message.
         */
        form.classList.add("contact-form--sent");
      },
    });
  }
</script>

<style>
  .contact {
    max-width: var(--content-width-xl);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .contact-lede {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg-primary);
    max-width: 64ch;
    margin: 0 0 var(--space-3xl) 0;
  }

  /*
   * Two-column layout: form on the left (1.6fr), alternative contact
   * paths on the right (1fr). Single column on mobile so the form
   * gets full width for comfortable typing.
   */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-4xl);
    align-items: start;
  }

  :global(.contact-form-panel) {
    padding: var(--space-3xl);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /*
   * Form row: two fields side by side. Useful for name + email pairing
   * since both are short and typing them on separate rows feels wasteful.
   */
  .contact-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  /* Actions row: submit button + small "response time" note */
  .contact-form-actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-md);
    flex-wrap: wrap;
  }

  .contact-form-note {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-fg-muted);
    margin: 0;
    line-height: 1.4;
  }

  /*
   * AJAX status regions.
   *
   * @formspree/ajax marks these elements with data-fs-active when it has
   * something to show and removes it when cleared, so that attribute is the
   * visibility switch. Gating on :empty instead would fail for the success
   * banner, whose copy is pre-filled in the markup above.
   *
   * Formspree's own stylesheet is switched off at init (useDefaultStyles:
   * false) because it ships its own error colours, success banner and
   * spinner, none of which match the Prism glass language. These rules are
   * the replacement.
   */
  .contact-form-status {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-lg) 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
  }

  .contact-form-status:not([data-fs-active]) {
    display: none;
  }

  /*
   * Banner text colour is deliberately --color-fg-primary, not the accent.
   *
   * The Prism generator regenerates --accent-emerald* per palette, so in a
   * purple-keyed palette "emerald" resolves to a purple only a shade off the
   * panel behind it, and accent-coloured banner text becomes almost
   * unreadable. The semantic instead lives in the border and background
   * tint, which stay legible whatever hue the palette assigns, while the
   * copy itself uses the foreground token that every mode guarantees
   * contrast for.
   */
  .contact-form-status--success {
    color: var(--color-fg-primary);
    border-color: var(--accent-emerald);
    background: color-mix(in oklch, var(--accent-emerald) 16%, transparent);
  }

  /*
   * Error border and tint reuse the exact rgba values GlassField and
   * GlassInput already use for their error states rather than introducing a
   * new colour. The text follows the same readability rule as success.
   */
  .contact-form-status--error {
    color: var(--color-fg-primary);
    border-color: rgba(255, 130, 110, 0.65);
    background: rgba(255, 130, 110, 0.12);
  }

  /* Per-field validation message, sits directly under its input. */
  .contact-field-error {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 140, 130, 0.95);
    margin-top: var(--space-2xs);
  }

  .contact-field-error:not([data-fs-active]) {
    display: none;
  }

  /*
   * On a successful AJAX submit the fields collapse so the confirmation
   * banner is the only thing left to read. The banner is rendered outside
   * the form element, so it survives this.
   */
  .contact-form--sent {
    display: none;
  }

  /*
   * Unconfigured-backend state. The notice reads above the email fallback
   * button rather than beside it, so this row stacks instead of running
   * horizontally like the live submit row does. Surface treatment is
   * deliberately absent: per COMPONENTS.md, notices get type and colour
   * from tokens, not a bespoke panel background.
   */
  .contact-form-actions--pending {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .contact-form-pending {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-fg-secondary);
    margin: 0;
    max-width: 52ch;
  }

  /* Alternative contact paths sidebar */
  .contact-alternatives {
    position: sticky;
    top: calc(var(--space-2xl) + 80px);
  }

  :global(.contact-alt-panel) {
    padding: var(--space-xl);
  }

  .contact-alt-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--color-fg-primary);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-lg) 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--glass-border);
  }

  .contact-alt-section {
    margin-bottom: var(--space-lg);
  }

  .contact-alt-section:last-child {
    margin-bottom: 0;
  }

  .contact-alt-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin: 0 0 var(--space-sm) 0;
  }

  .contact-alt-link {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-fg-secondary);
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--duration-base) var(--easing-out),
      border-color var(--duration-base) var(--easing-out);
  }

  .contact-alt-link:hover {
    color: var(--color-fg-primary);
  }

  .contact-alt-link--email {
    color: var(--accent-royal-bright);
    font-weight: 500;
  }

  .contact-alt-link--email:hover {
    color: var(--accent-royal-bright);
    border-bottom-color: var(--accent-royal-bright);
  }

  .contact-alt-meta {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-fg-muted);
    margin: var(--space-sm) 0 0 0;
  }

  .contact-alt-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-fg-secondary);
    margin: 0;
  }

  /* Tablet: tighter columns */
  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-xl);
    }
    :global(.contact-form-panel) {
      padding: var(--space-2xl);
    }
  }

  /* Mobile: stack columns, single-column form row */
  @media (max-width: 768px) {
    .contact {
      padding: 0 var(--space-lg);
    }
    .contact-lede {
      font-size: var(--text-lg);
      margin-bottom: var(--space-2xl);
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .contact-form-row {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .contact-alternatives {
      position: static;
    }
    :global(.contact-form-panel) {
      padding: var(--space-xl);
    }
    :global(.contact-alt-panel) {
      padding: var(--space-lg);
    }
  }
</style>
